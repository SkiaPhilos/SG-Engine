# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SAFEPAY_ENCRYPTION_KEY: 256-bit master secret key used to encrypt/decrypt Safepay credentials in the database vault (AES-256-GCM).
# Set directly in the Vercel / Cloud Run deploy configuration (do not commit to Git).
SAFEPAY_ENCRYPTION_KEY=

# SUPABASE CONFIGURATION:
# VITE_SUPABASE_URL (or SUPABASE_URL): Your Supabase Project URL (e.g. https://xyz.supabase.co)
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY (or SUPABASE_PUBLISHABLE_KEY / VITE_SUPABASE_PUBLISHABLE_KEY):
# Public publishable key (safe for browser client).
VITE_SUPABASE_ANON_KEY=

# SUPABASE_SECRET_KEY (or SUPABASE_SERVICE_ROLE_KEY):
# CRITICAL: Secret key used ONLY on the serverless backend. DO NOT prefix with VITE_ or expose to browser!
SUPABASE_SECRET_KEY=

# VITE_ADMIN_EMAIL: Optional email for the initial store owner/super administrator (defaults to first authenticated user)
VITE_ADMIN_EMAIL=

