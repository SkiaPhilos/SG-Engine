# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SAFEPAY_ENCRYPTION_KEY: 256-bit master secret key used to encrypt/decrypt Safepay credentials in the database vault (AES-256-GCM).
# Set directly in the Vercel / Cloud Run deploy configuration (do not commit to Git).
SAFEPAY_ENCRYPTION_KEY=

# SUPABASE CONFIGURATION:
# VITE_SUPABASE_URL: Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: Public, safe-to-expose anonymous client key for browser requests
VITE_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Secret service role key used ONLY by serverless functions (e.g. Safepay webhook)
SUPABASE_SERVICE_ROLE_KEY=

