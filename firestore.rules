rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email.lower() == 'maniacphilos@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection
    match /admins/{adminUid} {
      allow get: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == adminUid && request.auth.token.email.lower() == 'maniacphilos@gmail.com');
    }

    // Store root configuration
    match /stores/{storeId} {
      allow get: if isValidId(storeId);
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(storeId);

      // Categories subcollection
      match /categories/{categoryId} {
        allow get, list: if isValidId(storeId);
        allow write: if isAdmin() && isValidId(storeId) && isValidId(categoryId);
      }

      // Products subcollection
      match /products/{productId} {
        allow get, list: if isValidId(storeId);
        allow write: if isAdmin() && isValidId(storeId) && isValidId(productId);
      }

      // Offers subcollection
      match /offers/{offerId} {
        allow get, list: if isValidId(storeId);
        allow write: if isAdmin() && isValidId(storeId) && isValidId(offerId);
      }

      // Payment Destinations subcollection
      match /paymentMethods/{paymentMethodId} {
        allow get, list: if isValidId(storeId);
        allow write: if isAdmin() && isValidId(storeId) && isValidId(paymentMethodId);
      }

      // Orders subcollection
      match /orders/{orderId} {
        allow get: if isValidId(storeId) && isValidId(orderId);
        allow list: if isAdmin() && isValidId(storeId);
        allow create: if isValidId(storeId) && isValidId(orderId);
        allow update: if (isAdmin() && isValidId(storeId) && isValidId(orderId)) ||
          (isValidId(storeId) && isValidId(orderId) &&
           incoming().diff(existing()).affectedKeys().hasOnly(['paymentProofUrl', 'transactionReference', 'paymentStatus', 'updatedAt']));
        allow delete: if isAdmin() && isValidId(storeId) && isValidId(orderId);
      }
    }
  }
}
